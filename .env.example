# Copy this file to .env and fill in your real values.
# NEVER commit your real .env file to Git.

# MongoDB connection string (get from MongoDB Atlas)
DATABASE_URL="mongodb+srv://<db_user>:<db_password>@cluster.mongodb.net/devineora?retryWrites=true&w=majority"

# JWT Secret - generate a strong random key (run: node -e "require('crypto').randomBytes(64).toString('hex')" )
JWT_SECRET="replace-with-a-long-random-secret-at-least-64-chars"

# Admin login credentials - change these before going live
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="YourStrongPasswordHere!"

# Your public site URL
NEXT_PUBLIC_SITE_URL="https://www.devineora.com"
